# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — never commit real secrets
.env
.env.*
# ...but DO commit the placeholder example (no real secrets in it)
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Android signing (NEVER commit)
keystore/
mobile/android/keystore.properties

# Supabase backups (kung sakaling ma-run sa loob ng repo path) — never commit dumps
Sellerflow-backups/
backup_*.sql
server/scratch/

# Local vendor reference samples (SHOPMORE fixtures etc.) — never commit
vendor/

# Build artifacts + tooling accidentally committed via `git add -A` (2026-09-27) —
# untrack + ignore. mobile/www keeps its pre-existing tracked entries (gitignore
# only affects untracked files); new build output there stays ignored.
/www/
/graphify-out/
/.claude/
/supabase/.temp/
*.bak
mobile/www/
mobile/ios/App/golden
mobile/ios/App/manifest.json
mobile/ios/App/payloads
