{
  "manifest_version": 3,
  "name": "SellerFlowLive Parcel Checker",
  "version": "1.15.2",
  "description": "Checks if your parcels' 7-11 store and phone are OK.",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [
    "https://www.sellerflowlive.com/*",
    "https://sellerflowlive.com/*",
    "https://myship.7-11.com.tw/*",
    "https://emap.pcsc.com.tw/*",
    "https://emap.unipcsc.com.tw/*",
    "https://sqeuyuktdpidmlfpqgoc.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.sellerflowlive.com/*", "https://sellerflowlive.com/*"],
      "js": ["sellerflow-refresh-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.sellerflowlive.com/*", "https://sellerflowlive.com/*"],
      "js": ["sellerflow-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://myship.7-11.com.tw/*"],
      "js": ["myship-711.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://myship.7-11.com.tw/seller/order*"],
      "js": ["myship-order-711.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://myship.7-11.com.tw/seller/order*"],
      "js": ["myship-export-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://myship.7-11.com.tw/seller/order*"],
      "js": ["myship-export-711.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://emap.pcsc.com.tw/*", "https://emap.unipcsc.com.tw/*"],
      "js": ["emap-guid-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://emap.pcsc.com.tw/*", "https://emap.unipcsc.com.tw/*"],
      "js": ["emap-711.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SellerFlowLive Parcel Checker",
    "default_popup": "popup.html"
  }
}
