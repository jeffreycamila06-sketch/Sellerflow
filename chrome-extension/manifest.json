{
  "manifest_version": 3,
  "name": "SellerFlow Parcel Checker",
  "version": "1.6.0",
  "description": "Check SellerFlowLive parcel scans against 7-11 賣貨便 (full-store + restricted phone) using your logged-in session.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.sellerflowlive.com/*",
    "https://sellerflowlive.com/*",
    "https://myship.7-11.com.tw/*",
    "https://emap.pcsc.com.tw/*",
    "https://emap.unipcsc.com.tw/*",
    "https://sqeuyuktdpidmlfpqgoc.supabase.co/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.sellerflowlive.com/*", "https://sellerflowlive.com/*", "http://localhost:5173/*"],
      "js": ["sellerflow-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://myship.7-11.com.tw/*"],
      "js": ["myship-711.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://myship.7-11.com.tw/seller/order*"],
      "js": ["myship-order-711.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://myship.7-11.com.tw/seller/order*"],
      "js": ["myship-export-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://myship.7-11.com.tw/seller/order*"],
      "js": ["myship-export-711.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://emap.pcsc.com.tw/*", "https://emap.unipcsc.com.tw/*"],
      "js": ["emap-711.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SellerFlow Parcel Checker",
    "default_popup": "popup.html"
  }
}
