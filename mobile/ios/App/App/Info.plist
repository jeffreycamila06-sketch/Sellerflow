<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>SellerFlowLive</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>SellerFlowLive uses the camera to scan your parcel slips (para ma-scan ang parcel slips).</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>SellerFlowLive connects to your Bluetooth label printer to print order stickers.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>SellerFlowLive needs this to print on your WiFi printer.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>SellerFlowLive does not use your microphone. The printer component included in the app lists this permission, but the app never asks for it.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>SellerFlowLive does not use speech recognition. The printer component included in the app lists this permission, but the app never asks for it.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SellerFlowLive does not access your photos. The printer component included in the app lists this permission, but the app never asks for it.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>SellerFlowLive does not save anything to your photos. The printer component included in the app lists this permission, but the app never asks for it.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
